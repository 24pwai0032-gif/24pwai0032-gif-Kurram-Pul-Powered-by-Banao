# Copy this file to .env.local and fill in the key for the provider you use.
# Everything here is read only on the server (inside app/api routes). Never add a
# NEXT_PUBLIC_ prefix to these names: that would ship them to the browser.
# Restart `npm run dev` after changing this file.

# Which LLM answers every API route: "openai" or "grok". Defaults to openai.
LLM_PROVIDER=openai

# OpenAI, used when LLM_PROVIDER=openai. Keys: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional model override (default: gpt-6-luna).
# OPENAI_MODEL=gpt-6-luna

# Grok by xAI, used when LLM_PROVIDER=grok. Keys: https://console.x.ai
GROK_API_KEY=
# Optional model override (default: grok-4.7).
# GROK_MODEL=grok-4.7

# Only the key for the active provider is required.
